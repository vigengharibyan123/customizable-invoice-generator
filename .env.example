# Copy to `.env` (git-ignored) and fill in. Never commit real credentials.

# ── API server ───────────────────────────────────────────────────────────────
PORT=3001
# SQLite database file, relative to the repository root (created automatically).
DATABASE_PATH=./data/invoices.db

# ── Email ────────────────────────────────────────────────────────────────────
# Leave SMTP_HOST or SMTP_PASS empty to use a free Ethereal test inbox instead:
# nothing is delivered, and the app shows a link to preview the sent email.
#
# Resend (https://resend.com) over SMTP:
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=resend           SMTP_PASS=<your Resend API key, starts with re_>
# Any other SMTP provider (Postmark, Mailgun, SES, Gmail app password) works too.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Sender shown to recipients. Resend's sandbox sender `onboarding@resend.dev` can
# only deliver to the email address you signed up to Resend with.
EMAIL_FROM="Lumen & Oak Studio <onboarding@resend.dev>"
