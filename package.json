{
  "name": "customizable-invoice-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Customizable invoice generator: React + Vite web app, Express + SQLite API, invoice emails over SMTP.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev -w @invoice/api\" \"npm run dev -w @invoice/web\"",
    "build": "npm run build -w @invoice/web && npm run build -w @invoice/api",
    "start": "npm run start -w @invoice/api",
    "db:seed": "npm run db:seed -w @invoice/api",
    "db:reset": "npm run db:reset -w @invoice/api",
    "db:generate": "npm run db:generate -w @invoice/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
